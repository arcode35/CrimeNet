# Public CrimeSense API origin. Override only for explicit local development.
NEXT_PUBLIC_API_BASE_URL=https://api.crimesense.ai

# "api" uses the rolling live + forecast service; "fixture" is for deterministic tests.
NEXT_PUBLIC_CRIMENET_DATA_MODE=api

# Optional MapLibre style. Defaults to CARTO Dark Matter (no proprietary token).
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Public browser key used for MapTiler geocoding and the optional satellite raster source.
NEXT_PUBLIC_MAPTILER_KEY=
