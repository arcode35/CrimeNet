# Central FastAPI origin used when data mode is "api".
NEXT_PUBLIC_CRIMENET_API_URL=http://localhost:8000

# "fixture" keeps deterministic UI/test data; "api" uses the current live snapshot.
NEXT_PUBLIC_CRIMENET_DATA_MODE=fixture

# Optional MapLibre style. Defaults to CARTO Dark Matter (no proprietary token).
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Public browser key used for MapTiler geocoding and the optional satellite raster source.
NEXT_PUBLIC_MAPTILER_KEY=
