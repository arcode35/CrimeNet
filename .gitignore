.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.junit.xml
test-results/

# Type checker and linter caches
.mypy_cache/
.pyright/
.ruff_cache/
.dmypy.json
dmypy.json

# Databricks local bundle state
.databricks/
.databrickscfg

# Environment variables and local secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

