*.log
*.tmp
*.temp
*.swp
*.swo
.cache/
tmp/
temp/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.idea/
.vscode/

